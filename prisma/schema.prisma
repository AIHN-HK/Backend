generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int            @id @default(autoincrement())
  fullname      String
  role          String         @default("USER")
  password      String
  email         String         @unique
  yob           DateTime
  phone         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  address       String?
  gender        String?
  class         Int?
  attempts      Attempt[]
  chatSessions  ChatSession[]
  refreshTokens RefreshToken[]
  careerProfile CareerProfile?
  recommendations RecommendationRun[]
  careerGoals CareerGoal[]
  guestAssessmentClaims GuestAssessmentClaim[]
}

model Otp {
  email     String
  code      String
  type      OtpType
  expiresAt DateTime
  used      Boolean  @default(false)
  failedAttempts Int @default(0)
  createdAt DateTime @default(now())
  id        Int      @id @default(autoincrement())

  @@unique([email, type])
  @@index([expiresAt])
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  expiresAt DateTime
  userId    Int
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  @@index([userId])

}

model Question {
  id        Int                @id @default(autoincrement())
  content   String
  type      String
  createdAt DateTime           @default(now())
  dimension QuestionDimension?
  answers   Answer[]
}

model Attempt {
  id             Int           @id @default(autoincrement())
  totalQuestions Int
  createdAt      DateTime      @default(now())
  finishAt       DateTime?
  userId         Int?
  answers        Answer[]
  user           User?         @relation(fields: [userId], references: [id])
  chatSessions   ChatSession[]
  result         Result?
  snapshots      SnapShot?
  recommendations RecommendationRun[]
  guestClaim GuestAssessmentClaim?

  @@index([userId, finishAt, createdAt, id])
}

model GuestAssessmentClaim {
  id        String   @id
  digest    String
  userId    Int
  attemptId Int      @unique
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempt   Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Answer {
  id          Int      @id @default(autoincrement())
  attemptId   Int
  questionId  Int
  answerValue Int
  attempt     Attempt  @relation(fields: [attemptId], references: [id])
  question    Question @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
}

model Result {
  id        Int     @id @default(autoincrement())
  attemptId Int     @unique
  scoreR    Int
  scoreI    Int
  scoreA    Int
  scoreS    Int
  scoreE    Int
  scoreC    Int
  topCode   String
  attempt   Attempt @relation(fields: [attemptId], references: [id])
}

model ChatSession {
  id        Int               @id @default(autoincrement())
  userId    Int
  socketId  String
  status    ChatSessionStatus @default(ACTIVE)
  createdAt DateTime          @default(now())
  closedAt  DateTime?
  title     String?
  attemptId Int
  summary   String?
  messages  ChatMessage[]
  attempt   Attempt           @relation(fields: [attemptId], references: [id])
  user      User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([attemptId])
}

model ChatMessage {
  id         Int         @id @default(autoincrement())
  sessionId  Int
  content    String
  createdAt  DateTime    @default(now())
  role       ChatRole?
  checkpoint Int         @default(0)
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model SnapShot {
  id        Int     @id @default(autoincrement())
  attemptId Int     @unique
  snapshot  Json
  attempt   Attempt @relation(fields: [attemptId], references: [id])
}

model Priority {
  id       Int    @id @default(autoincrement())
  type     String @unique
  priority Int
}

model TopCode {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  title       String
  personality Json
  strengths   Json
  weaknesses  Json
  careers     Json
  description String?
}

model SampleTable {
  id   Int    @id @default(autoincrement())
  name String
}

model AdminAuditLog {
  id        Int      @id @default(autoincrement())
  actorId   Int
  action    String
  entity    String
  targetId  String
  before    Json
  after     Json
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entity, targetId, createdAt])
}

model HollandCase {
  id          Int     @id @default(autoincrement())
  condition   String
  code        String  @unique
  title       String
  personality Json
  strengths   Json
  weaknesses  Json
  careers     Json
  description String?
}

enum UserRole {
  ADMIN
  USER
}

enum ChatRole {
  user
  assistant
}

enum QuestionType {
  R
  I
  A
  S
  E
  C
}

enum QuestionDimension {
  PERSONA
  ABILITY
  INTEREST
}

/// /////////////////////////////////////////////////
/// /////////////////////////////////////////////////
enum OtpType {
  REGISTER
  FORGOT_PASSWORD
}

enum ChatSessionStatus {
  ACTIVE
  CLOSED
}

// Career data is versioned, sourced and published independently of assessment scoring.
model Career {
  id String @id
  title String
  description String
  riasec Json
  sourceVersion String
  sourceUrl String
  active Boolean @default(true)
  revision Int @default(1)
  skills CareerSkill[]
  profiles CareerProfile[]
  goals CareerGoal[]
}

model Skill {
  id String @id
  name String
  careers CareerSkill[]
}

model CareerSkill {
  careerId String
  skillId String
  importance Float
  level Float
  career Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id])
  @@id([careerId, skillId])
}

model CareerProfile {
  userId Int @id
  revision Int @default(1)
  skills Json
  interests Json?
  targetCareerId String?
  user User @relation(fields: [userId], references: [id])
  target Career? @relation(fields: [targetCareerId], references: [id])
  updatedAt DateTime @default(now()) @updatedAt
}

model RecommendationRun {
  id String @id @default(uuid())
  userId Int
  attemptId Int
  algorithmVersion String
  input Json
  items Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  attempt Attempt @relation(fields: [attemptId], references: [id])
  @@index([userId, createdAt, id])
}

model CareerGoal {
  id String @id @default(uuid())
  userId Int
  careerId String
  title String
  revision Int @default(1)
  evidence Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id])
  career Career @relation(fields: [careerId], references: [id])
  tasks GoalTask[]
  @@unique([userId, careerId])
}

model GoalTask {
  id String @id @default(uuid())
  goalId String
  skillId String
  title String
  evidence String @default("")
  done Boolean @default(false)
  position Int
  phase Int @default(0)
  kind String @default("practice")
  goal CareerGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  @@index([goalId, position])
}
