# Application
NODE_ENV=development
PORT=3000
API_VERSION=v1

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aihn_dev?schema=public"
# Optional local demo seed password (defaults documented in README).
# Only read by the explicit seed:demo/setup:demo commands; never used in production.
SEED_DEMO_PASSWORD=

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Logging
LOG_LEVEL=debug

# Optional: explicit admin bootstrap CLI only (npm run admin:bootstrap)
# Set these in your ignored local .env or deployment secret environment.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULLNAME=
BOOTSTRAP_ADMIN_YOB=

# Optional: email configuration for sending emails (e.g., password reset, email verification)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=...
MAIL_PASS=...
MAIL_FROM=...

# OTP hashing. Empty uses JWT_ACCESS_SECRET; changing either invalidates active OTPs.
OTP_HASH_SECRET=
# Redis shared by cache, Bull, locks
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# Server-side AI bridge, never a VITE secret; blank disables advisor generation
AI_WS_URL=ws://127.0.0.1:8000
AI_CONNECT_TIMEOUT_MS=10000
AI_IDLE_TIMEOUT_MS=30000
AI_MAX_DURATION_MS=120000
CHAT_TURN_LEASE_MS=600000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRUST_PROXY_HOPS=0

# Production SendGrid; keep in the deployment secret environment.
SENDGRID_API_KEY=
